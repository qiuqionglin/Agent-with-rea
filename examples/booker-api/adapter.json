            "additionalneeds"
          ],
          "properties": {
            "firstname": {
              "type": "string"
            },
            "lastname": {
              "type": "string"
            },
            "additionalneeds": {
              "type": "string"
            }
          }
        }
      },
      "update": {
        "method": "PATCH",
        "path": "/booking/{bookingId}",
        "statuses": [
          200
        ],
        "responseSchema": {
          "type": "object",
          "required": [
            "firstname",
            "lastname",
            "totalprice",
            "depositpaid",
            "bookingdates",
            "additionalneeds"
          ],
          "properties": {
            "firstname": {
              "type": "string"
            },
            "lastname": {
              "type": "string"
            },
            "totalprice": {
              "type": "number"
            },
            "depositpaid": {
              "type": "boolean"
