  "analysis": {
    "recipe": "Capture ordinals 1–5 show GET, field-only PATCH, confirming GET, restoring PATCH and confirming GET. Use the caller's origin, credential environment binding, resource parameter mapping and ownership assertions. The shared HTTP factory checks a fresh baseline, dispatches once and verifies the complete expected resource through fresh GETs. Scope is the configured HTTP session and resource; user identity is not established.",
    "claims": [
      {
        "operation": "inspect_web_network_capture",
        "contains": "PATCH"
      },
      {
        "operation": "inspect_web_network_capture",
        "contains": "observed-api-update"
      },
      {
        "operation": "inspect_web_network_capture",
        "contains": "additionalneeds"
