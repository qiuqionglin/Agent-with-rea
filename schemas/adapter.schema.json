{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "app2cli adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "platform", "verification", "commands", "analysis", "config"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,48}$"},
    "description": {"type": "string", "minLength": 1},
    "platform": {"enum": ["web", "android"]},
    "verification": {"enum": ["reload-persisted", "native-ui-readback", "server-confirmed"]},
    "config": {"type": "object"},
    "analysis": {"type": "object", "required": ["recipe", "claims"], "properties": {"recipe": {"type": "string"}, "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}}}, "additionalProperties": false},
    "commands": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "readOnly", "inputSchema"],
        "properties": {"description": {"type": "string"}, "readOnly": {"type": "boolean"}, "inputSchema": {"type": "object"}}
      }
    }
  }
}
